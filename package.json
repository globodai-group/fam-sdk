{
  "name": "globodai-fam-sdk",
  "version": "1.2.0",
  "description": "Official TypeScript SDK for the FAM API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "require": "./dist/webhooks/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "knip": "knip",
    "madge": "madge --circular --extensions ts src/",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "ci:check": "pnpm run check && pnpm run knip && pnpm run madge",
    "ci:test": "pnpm run test:coverage",
    "ci:build": "pnpm run build",
    "prepublishOnly": "pnpm run ci:check && pnpm run ci:test && pnpm run ci:build",
    "prepare": "husky"
  },
  "keywords": [
    "fam",
    "mangopay",
    "sdk",
    "api",
    "typescript",
    "payments"
  ],
  "author": "FAM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globodai-group/fam-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/globodai-group/fam-sdk/issues"
  },
  "homepage": "https://github.com/globodai-group/fam-sdk#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "flatted@<3.4.0": ">=3.4.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss@<8.5.10": ">=8.5.10",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^2.1.9",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "semantic-release": "25.0.3",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^2.1.9"
  }
}
