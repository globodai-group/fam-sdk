{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // tsup's dts build (rollup-plugin-dts) implicitly injects the now-deprecated
    // `baseUrl` whenever `paths` is set. Until tsup stops doing so, opt into the
    // TS 6.0 deprecation grace period so the declaration build keeps working.
    "ignoreDeprecations": "6.0",
    "paths": {
      "globodai-fam-sdk": ["./src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "src/__tests__"]
}
